# Copy this file to .env and fill in your own keys. Never commit .env.
# Which steps need which key is listed in README.md.

# SEC EDGAR: required by every SEC step (any "Name email@example.com" string)
SEC_USER_AGENT=

# Databento: price downloads (download_event_prices.py, risk_diagnostics.py SPY)
DATABENTO_API_KEY=

# Google Gemini: only to re-run the AI steps (filter, extract, match, score); answers are saved in labels/.
# run_all.py --full also needs it (those scripts start a Gemini client even when every answer is saved)
GEMINI_API_KEY=

# Massive: only for the event-search recall check (find_events.py downloads the tags, check_coverage.py compares);
# run_all.py --full also needs it
MASSIVE_API_KEY=

# Webull: only for the optional Databento-vs-Webull price cross-check (download_prices.py)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us