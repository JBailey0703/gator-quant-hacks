# Copy this file to .env in the same folder. Optional, and not scored.
# .env is gitignored: never commit it.

# prod or sandbox: selects which credential set below is used
WEBULL_ENV=sandbox

WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

WEBULL_SANDBOX_APP_KEY=your_sandbox_app_key
WEBULL_SANDBOX_APP_SECRET=your_sandbox_app_secret
# WEBULL_SANDBOX_API_ENDPOINT=us-sandbox-api.pre.webullbroker.com

WEBULL_SYMBOLS=AAPL
WEBULL_CATEGORY=US_STOCK
WEBULL_TIMESPAN=M1
WEBULL_STRATEGY=dual_ma

# 0 runs the strategy without placing orders. 1 places REAL orders through the trading API.
WEBULL_USE_BROKER=0
# WEBULL_ACCOUNT_ID=
# WEBULL_SANDBOX_ACCOUNT_ID=
# WEBULL_TRADE_MARKET=US
# WEBULL_TRADING_SESSION=CORE
